--- name: FCB1010 - hold shift bridge
--- realearn_version: 2.18.0
--- author: MIDI Control Center
--- description: |
---     Turns one Behringer FCB1010 foot switch into a TRUE hold modifier for the Oxygen Pro 61 unit.
---     This unit listens on the MIDI interface the pedal board is plugged into. When the configured switch is
---     pressed it injects "CC 105 on channel 14, value 127" into the keyboard's MIDIIN3 input; on release it injects
---     value 0. The Oxygen preset (generated by the editor) declares an external hold modifier with the same CC and
---     channel, so any keyboard button pressed while the foot is down fires its "shift" function instead.
---     The Oxygen buttons themselves keep sending their normal CCs, which is what makes this a real hold modifier:
---     the keyboard never knows about the pedal, only ReaLearn does.
---
---     Configure SOURCE below to match what the switch sends (see docs/FCB1010_SHIFT.md):
---       kind = "note": the preset's Note message (note-on on press, note-off on release; stock firmware)
---       kind = "cc":   a CC that sends one value on press and another on release (UnO / other firmware)
---     MIDIIN3_DEVICE is REAPER's device number of "MIDIIN3 (Oxygen Pro 61)"; the setup script rewrites it.

--!strict

local SOURCE = { kind = "note", channel = 15, number = 60 }     -- FCB1010 NOTE preset: note 60 on MIDI channel 16 (0-based 15)
local MIDIIN3_DEVICE = 16                                         -- rewritten by "MIDI Control Center - Setup.lua"
local EXQUIS_DEVICE = 8                                           -- REAPER input number of "Exquis" (nil to skip); rewritten by the setup script
local SHIFT_CC, SHIFT_CHANNEL = 105, 13                           -- what the Oxygen preset expects (channel 14, 0-based 13)

local source
if SOURCE.kind == "note" then
    source = { kind = "MidiNoteVelocity", channel = SOURCE.channel, key_number = SOURCE.number }
else
    source = { kind = "MidiControlChangeValue", channel = SOURCE.channel, controller_number = SOURCE.number, character = "Button" }
end

local mappings = {
    {
        id = "fcb-shift",
        name = "FCB1010 switch -> hold shift (CC " .. SHIFT_CC .. " ch " .. (SHIFT_CHANNEL + 1) .. " into MIDIIN3)",
        feedback_enabled = false,
        source = source,
        -- value follows the source: note-on velocity (> 0) -> 127-ish, note-off -> 0; the Oxygen side treats anything > 0 as held
        target = {
            kind = "SendMidi",
            message = string.format("%02X %02X [0gfe dcba]", 0xB0 + SHIFT_CHANNEL, SHIFT_CC),
            destination = { kind = "InputDevice", device_id = MIDIIN3_DEVICE },
        },
    },
}
-- the same hold flag for the Exquis unit (its preset reads CC 105 on channel 14 as its shift modifier)
if EXQUIS_DEVICE ~= nil then
    table.insert(mappings, {
        id = "fcb-shift-exquis", name = "FCB1010 switch -> hold shift into Exquis", feedback_enabled = false,
        source = source,
        target = { kind = "SendMidi", message = string.format("%02X %02X [0gfe dcba]", 0xB0 + SHIFT_CHANNEL, SHIFT_CC),
                   destination = { kind = "InputDevice", device_id = EXQUIS_DEVICE } },
    })
end

return { mappings = mappings }
